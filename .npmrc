# Supply-chain hardening. See notes in git history / AGENTS.md.

# Never run pre/post-install scripts from dependencies. This is the main
# vector for malicious package versions. Run `npm rebuild <pkg>` by hand if
# some package genuinely needs its build step (esbuild ships prebuilt binaries).
ignore-scripts=true

# `npm install` must not silently rewrite package-lock.json.
# Use `npm ci` for installs; deliberate upgrades need --no-save=false / manual edit.
save-exact=true

