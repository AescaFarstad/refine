Project.ts

These are tasks for the player to complete.

ProjectLibDef:
name
description
kind:z5 refine_specific_item | refine_x_items | refine_x_essences | refine_x_resource | refine_with_yield_bonus | refine_together
params //depend on kind
  refine_specific_item: item name, count
  refine_x_items: count
  refine_x_unique_items: count
  refine_x_essences: color, count
  refine_x_resource: resource_name, count //refine that much in a single successfull refinment
  refine_with_yield_bonus: bonus_value
  refine_together: list of item ids and their counts to be successfully refined at the same time

rewardOptions: ProjectRewardOption[]
triggers: Trigger[] //when trigger fires, the 


ProjectRewardOption
  reward
  customName


